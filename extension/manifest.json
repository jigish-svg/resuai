{
  "manifest_version": 3,
  "name": "GetJobFit.in — Job Capture",
  "description": "Detect job postings on any site and send them to your GetJobFit workspace in one click.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.naukri.com/*",
    "https://*.glassdoor.com/*",
    "https://*.indeed.com/*",
    "https://*.shine.com/*",
    "https://*.instahyre.com/*",
    "https://*.getjobfit.in/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/jobs/*",
        "https://*.naukri.com/*",
        "https://*.glassdoor.com/*",
        "https://*.indeed.com/*",
        "https://*.shine.com/*",
        "https://*.instahyre.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
